# SAHTE ÖRNEK DEĞERLER — gerçek anahtarı buraya YAZMA. Gerçek değerler .env veya secret manager'da.
APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/borsa_dev
REDIS_URL=redis://localhost:6379/0
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=changeme
SESSION_SECRET=changeme-generate-long-random
EMAIL_PROVIDER_API_KEY=changeme
EMAIL_FROM_ADDRESS=noreply@borsaanaliz.local
EMAIL_SENDER_DOMAIN=borsaanaliz.local
EMAIL_DMARC_POLICY=reject
EMAIL_DKIM_SELECTOR=default
# LLM (isteğe bağlı özellik)
LLM_ENABLED=false
LLM_API_KEY=changeme
LLM_MODEL=configure-me
LLM_MAX_OUTPUT_TOKENS=300
LLM_DAILY_BUDGET_USD=1
LLM_USER_DAILY_CALLS=10
FORECAST_ENABLED=false
# DB Performans ve Yavaş Sorgu Günlüğü
SLOW_QUERY_LOGGING_ENABLED=true
SLOW_QUERY_THRESHOLD_MS=200
# Güvenlik, TLS, CORS & CSP
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
ENABLE_HSTS=true
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
CSP_ENABLED=true
CSP_REPORT_ONLY=false
